# Steam Web API key (https://steamcommunity.com/dev/apikey). Never commit the real value.
STEAM_API_KEY=
# Used by docker-compose to create the PostgreSQL database and build DATABASE_URL.
POSTGRES_USER=archipelago
POSTGRES_PASSWORD=change-me
POSTGRES_DB=archipelago
# Docker Compose derives DATABASE_URL from the values above. Set it only for non-Docker runs,
# e.g. postgresql+psycopg://user:password@localhost:5432/archipelago
DATABASE_URL=
# Comma separated list of allowed browser origins (the frontend is served on port 8080 by default).
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO
# Seconds during which a synchronized Steam library is considered fresh.
STEAM_CACHE_DURATION=3600
# Synchronize Archipelago sources at backend startup.
ARCHIPELAGO_SYNC_ENABLED=true
# Secret used to sign administration tokens. Leave empty to use a random secret generated and stored in the database.
ADMIN_SECRET_KEY=
